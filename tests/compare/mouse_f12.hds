# Mouse on F12 Song Variables: buttons, toggles, sliders (click + drag).
mask 9,62,9,79
mask 6,62,7,79
@dos waittext Continue
@dos key enter
@port keys f3 f9
stable 800
key f12
stable
capture mf_start
click 38 30
stable
capture mf_click_samples
click 22 30
stable
capture mf_click_instruments
click 45 30
stable
capture mf_init_instruments_no
click 38 33
stable
capture mf_click_mono
click 38 36
stable
capture mf_click_amiga
click 18 26
stable
capture mf_click_old_effects
drag 31 23 22 23
stable
capture mf_drag_global_volume
click 40 19
stable
capture mf_click_tempo
