# Mouse on F11: order list, pan sliders, volume page.
mask 9,62,9,79
mask 6,62,7,79
@dos waittext Continue
@dos key enter
@port keys f3 f9
stable 800
key down
key enter
waittext Drifting Onwards
stable 1000
key f11
stable
click 7 18
stable
capture mo11_click_order3
click 34 16
stable
capture mo11_click_pan_ch2
drag 31 18 39 18
stable
capture mo11_drag_pan_ch4
click 68 20
stable
capture mo11_click_pan_ch38
key f11
stable
click 33 17
stable
capture mo11_click_vol_ch3
drag 39 19 32 19
stable
capture mo11_drag_vol_ch5
