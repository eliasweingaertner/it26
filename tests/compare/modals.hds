# Round 2: modal dialogs and menus on an empty song, opened from the
# pattern editor (main menu + submenus, quit/new song confirmations,
# Pattern Editor Options). it26 has no New Song dialog yet (Ctrl-N clears
# at once), so on the port the Esc after it opens the main menu; a second
# @port Esc closes it again.
mask 9,62,9,79
mask 6,62,7,79
@dos waittext Continue
@dos key enter
@port keys f3 f9
stable 800
key f2
stable
key esc
stable
capture mo_main_menu
key enter
stable
capture mo_menu_file
key down
key down
stable
capture mo_menu_file_down2
key esc
stable
capture mo_main_menu_back
key down
key enter
stable
capture mo_menu_playback
key esc
stable
key down
key down
key enter
stable
capture mo_menu_sample
key esc
stable
key down
key enter
stable
capture mo_menu_instrument
key esc
stable
key esc
stable
capture mo_menu_closed
key esc
stable
capture mo_main_menu_reopened
key esc
stable
key ctrl-q
stable
capture mo_confirm_quit
key esc
stable
key ctrl-n
stable
capture mo_confirm_new
key esc
stable
@port key esc
@port stable
key f2
stable
capture mo_pe_options
key esc
stable
capture mo_pe_options_closed
