# Mouse on Ctrl-F12 Palette Configuration: sliders and preset buttons.
mask 9,62,9,79
mask 6,62,7,79
@dos waittext Continue
@dos key enter
@port keys f3 f9
stable 800
key ctrl-f12
stable
click 14 14
stable
capture mp_click_red0
drag 10 20 17 20
stable
capture mp_drag_green1
click 66 31
stable
capture mp_click_gold
click 66 46
stable
capture mp_click_volcanic
click 66 34
stable
capture mp_click_camouflage
