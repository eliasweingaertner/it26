# build output
/build/
/build-*/
*.exe
*.obj
*.o
*.pdb
*.ilk
# shared/static libs from out-of-tree builds
*.a
*.so
*.dll

# editor runtime config (per-user; feature 014 adds keyboard_cfg/keyboard_layout)
/ited.cfg

# Makefile build tree + POSIX binaries
/build-make/
/itplay
/ited
/test_pattern

# VGA ROM font: fetched on demand by `make font` (a dump of IBM's VGA BIOS
# character ROM), never committed. See the Makefile "ROM font" section.
/tools/IBM_VGA_8x8.bin
/tools/IBM_VGA_8x8.bin.tmp

# editor debug dumps
screen_dump.txt

# editor-generated WAV renders
*.wav

# ITED_SHOT pixel captures (but keep the corner-art source bitmap)
*.bmp
!/art/corner.bmp

# OS cruft
.DS_Store
Thumbs.db
